@model ES2.DTOs.RelatorioAdminDto
@{
    ViewData["HideChrome"] = true;
    ViewData["HideFooter"] = true;
    ViewData["Title"] = "Relatorios";

    var meses = Model.EventosPorMes.Select(e => $"\"{e.NomeMes}\"").ToList();
    var totaisMes = Model.EventosPorMes.Select(e => e.TotalEventos.ToString()).ToList();
    var categorias = Model.EventosPorCategoria.Select(e => $"\"{e.Categoria}\"").ToList();
    var totaisCat = Model.EventosPorCategoria.Select(e => e.TotalEventos.ToString()).ToList();
}

<section class="eh-reports-page">
    <div class="eh-reports-shell">
        <div class="eh-reports-hero">
            <div>
                <p class="eh-reports-kicker">Area administrativa</p>
                <h1>Relat&oacute;rios</h1>
                <p>Consulta os principais indicadores da plataforma Event Horizon.</p>
            </div>

            <a class="eh-reports-home" asp-controller="Home" asp-action="Index">
                <i class="bi bi-arrow-left"></i>
                Voltar &agrave; home
            </a>
        </div>

        <div class="eh-reports-metrics">
            <article class="eh-report-metric">
                <i class="bi bi-calendar-event"></i>
                <div>
                    <strong>@Model.TotalEventos</strong>
                    <span>Total de Eventos</span>
                </div>
            </article>

            <article class="eh-report-metric">
                <i class="bi bi-people"></i>
                <div>
                    <strong>@Model.TotalUtilizadores</strong>
                    <span>Utilizadores Registados</span>
                </div>
            </article>

            <article class="eh-report-metric">
                <i class="bi bi-ticket-perforated"></i>
                <div>
                    <strong>@Model.TotalInscricoes</strong>
                    <span>Total de Inscri&ccedil;&otilde;es</span>
                </div>
            </article>

            <article class="eh-report-metric">
                <i class="bi bi-graph-up-arrow"></i>
                <div>
                    <strong>@Model.MediaEventosPorMes</strong>
                    <span>M&eacute;dia de Eventos por M&ecirc;s</span>
                </div>
            </article>

            <article class="eh-report-metric">
                <i class="bi bi-person-check"></i>
                <div>
                    <strong>@Model.MediaParticipantesPorEvento</strong>
                    <span>M&eacute;dia de Participantes por Evento</span>
                </div>
            </article>

            <article class="eh-report-metric eh-report-metric--accent">
                <i class="bi bi-currency-euro"></i>
                <div>
                    <strong>@Model.ReceitaTotal.ToString("F2") &euro;</strong>
                    <span>Receita Total</span>
                </div>
            </article>
        </div>

        <div class="eh-reports-grid">
            <article class="eh-report-panel eh-report-panel--wide">
                <div class="eh-report-panel-head">
                    <h2><i class="bi bi-bar-chart"></i> Eventos por M&ecirc;s</h2>
                </div>
                <div class="eh-report-chart">
                    @if (Model.EventosPorMes.Any())
                    {
                        <canvas id="graficoEventosMes" height="105"></canvas>
                    }
                    else
                    {
                        <p class="eh-report-empty">Sem dados dispon&iacute;veis.</p>
                    }
                </div>
            </article>

            <article class="eh-report-panel">
                <div class="eh-report-panel-head">
                    <h2><i class="bi bi-pie-chart"></i> Eventos por Categoria</h2>
                </div>
                <div class="eh-report-chart">
                    @if (Model.EventosPorCategoria.Any())
                    {
                        <canvas id="graficoCategoria" height="220"></canvas>
                    }
                    else
                    {
                        <p class="eh-report-empty">Sem dados dispon&iacute;veis.</p>
                    }
                </div>
            </article>
        </div>

        <div class="eh-reports-grid eh-reports-grid--tables">
            <article class="eh-report-panel">
                <div class="eh-report-panel-head">
                    <h2><i class="bi bi-table"></i> Detalhe: Eventos por M&ecirc;s</h2>
                </div>

                @if (Model.EventosPorMes.Any())
                {
                    <div class="eh-report-table-wrap">
                        <table class="eh-report-table">
                            <thead>
                            <tr>
                                <th>M&ecirc;s</th>
                                <th>N.&ordm; de Eventos</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var item in Model.EventosPorMes)
                            {
                                <tr>
                                    <td>@item.NomeMes</td>
                                    <td>@item.TotalEventos</td>
                                </tr>
                            }
                            </tbody>
                            <tfoot>
                            <tr>
                                <td>M&eacute;dia</td>
                                <td>@Model.MediaEventosPorMes</td>
                            </tr>
                            </tfoot>
                        </table>
                    </div>
                }
                else
                {
                    <p class="eh-report-empty">Sem dados dispon&iacute;veis.</p>
                }
            </article>

            <article class="eh-report-panel">
                <div class="eh-report-panel-head">
                    <h2><i class="bi bi-table"></i> Detalhe: Eventos por Categoria</h2>
                </div>

                @if (Model.EventosPorCategoria.Any())
                {
                    <div class="eh-report-table-wrap">
                        <table class="eh-report-table">
                            <thead>
                            <tr>
                                <th>Categoria</th>
                                <th>N.&ordm; de Eventos</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var item in Model.EventosPorCategoria)
                            {
                                <tr>
                                    <td>@item.Categoria</td>
                                    <td>@item.TotalEventos</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="eh-report-empty">Sem dados dispon&iacute;veis.</p>
                }
            </article>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        Chart.defaults.color = 'rgba(255,255,255,0.72)';
        Chart.defaults.borderColor = 'rgba(255,255,255,0.12)';
        Chart.defaults.font.family = "'Inter', system-ui, sans-serif";

        @if (Model.EventosPorMes.Any())
        {
            <text>
            new Chart(document.getElementById('graficoEventosMes'), {
                type: 'bar',
                data: {
                    labels: [@Html.Raw(string.Join(",", meses))],
                    datasets: [{
                        label: 'Eventos',
                        data: [@string.Join(",", totaisMes)],
                        backgroundColor: 'rgba(255, 204, 0, 0.72)',
                        borderColor: 'rgba(255, 204, 0, 1)',
                        borderWidth: 1.5,
                        borderRadius: 8
                    }]
                },
                options: {
                    responsive: true,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true, ticks: { stepSize: 1 } },
                        x: { grid: { display: false } }
                    }
                }
            });
            </text>
        }

        @if (Model.EventosPorCategoria.Any())
        {
            <text>
            new Chart(document.getElementById('graficoCategoria'), {
                type: 'doughnut',
                data: {
                    labels: [@Html.Raw(string.Join(",", categorias))],
                    datasets: [{
                        data: [@string.Join(",", totaisCat)],
                        borderColor: 'rgba(10,10,10,0.92)',
                        borderWidth: 4,
                        backgroundColor: [
                            'rgba(255,204,0,0.88)', 'rgba(255,239,153,0.82)', 'rgba(120,120,120,0.78)',
                            'rgba(255,178,64,0.82)', 'rgba(190,190,190,0.7)', 'rgba(255,214,64,0.76)',
                            'rgba(90,90,90,0.78)', 'rgba(255,153,51,0.78)'
                        ]
                    }]
                },
                options: {
                    responsive: true,
                    cutout: '64%',
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { boxWidth: 12, padding: 16 }
                        }
                    }
                }
            });
            </text>
        }
    </script>
}
