<!DOCTYPE html>
@{
    var hideChrome = ViewData["HideChrome"] is true;
    var hideFooter = ViewData["HideFooter"] is true;
    var fullBleed = hideChrome || ViewData["FullBleed"] is true;
    var useEventHorizonNavbar = ViewData["UseEventHorizonNavbar"] is true;
}
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - ES2</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico?v=event-horizon-mark" />
    <link rel="icon" type="image/svg+xml" href="~/event-horizon-icon.svg" asp-append-version="true" />
    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/mensagens-widget.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/ES2.styles.css" asp-append-version="true"/>
</head>
<body class="@($"{(hideChrome ? "eh-shellless" : string.Empty)} {(useEventHorizonNavbar ? "eh-has-new-nav" : string.Empty)}")">
@if (!hideChrome)
{
<header>
    @if (useEventHorizonNavbar)
    {
    <nav class="eh-topnav">
        <div class="eh-topnav-inner">
            <div class="eh-topnav-left">
                <a class="eh-topnav-brand" asp-controller="Home" asp-action="Index">
                    <span class="eh-topnav-mark"><span></span></span>
                    <span>Event Horizon</span>
                </a>

                <ul class="eh-topnav-links">
                    <li>
                        <a asp-controller="Home" asp-action="Index">Pagina inicial</a>
                    </li>
                    <li class="eh-topnav-dropdown">
                        <button type="button">
                            Eventos
                            <i class="bi bi-chevron-down"></i>
                        </button>
                        <div class="eh-topnav-menu">
                            <a asp-controller="Home" asp-action="Index" asp-route-page="events">Ver Eventos</a>
                            @if (User.Identity?.IsAuthenticated == true && (User.IsInRole("Admin") || User.IsInRole("Organizador")))
                            {
                                <a asp-controller="Evento" asp-action="Criar">Criar Eventos</a>
                                <a asp-controller="Evento" asp-action="Gerir">Gerir Eventos</a>
                            }
                        </div>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li>
                            <a asp-controller="Atividade" asp-action="Index">Atividades</a>
                        </li>
                        @if (!User.IsInRole("Admin"))
                        {
                            <li>
                                <a asp-controller="Bilhete" asp-action="Index">Bilhetes</a>
                            </li>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <li>
                                <a asp-controller="Relatorios" asp-action="Index">Relatórios</a>
                            </li>
                        }
                    }
                </ul>
            </div>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="eh-topnav-dropdown eh-topnav-user">
                    <button type="button">
                        @(User.Identity.Name ?? "Utilizador")
                        <i class="bi bi-chevron-down"></i>
                    </button>
                    <div class="eh-topnav-menu eh-topnav-menu--right">
                        <a asp-controller="Utilizador" asp-action="Detalhes">Mais Detalhes</a>
                        @if (!User.IsInRole("Admin"))
                        {
                            <a asp-controller="Bilhete" asp-action="HistoricoCompras">Compras</a>
                        }
                        <form asp-controller="Login" asp-action="Logout" method="post">
                            <button type="submit">Sair</button>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <div class="eh-topnav-auth">
                    <a asp-controller="Home" asp-action="Index" asp-route-page="login">Login</a>
                    <a asp-controller="Home" asp-action="Index" asp-route-page="register">Registo</a>
                </div>
            }
        </div>
    </nav>
    }
    else
    {
    @* Navbar antiga mantida em comentário caso volte a ser necessária.
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark mb-3 shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand text-white" asp-area="" asp-controller="Home" asp-action="Index">ES2</a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-controller="Home" asp-action="Privacy">Privacy</a>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white" href="#" id="eventosDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Eventos
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="eventosDropdown">
                                <li>
                                    <a class="dropdown-item" asp-controller="Home" asp-action="Index" asp-route-page="events">Ver Eventos</a>
                                </li>
                                @if (User.IsInRole("Admin") || User.IsInRole("Organizador"))
                                {
                                    <li>
                                        <a class="dropdown-item" asp-controller="Evento" asp-action="Criar">Criar Evento</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Evento" asp-action="Gerir">Gerir Eventos</a>
                                    </li>
                                }
                            </ul>
                        </li>
                        
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Atividade" asp-action="Index">Atividades</a>
                        </li>
                        @if (!User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Bilhete" asp-action="Index">Bilhetes</a>
                            </li>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Relatorios" asp-action="Index">Relatórios</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Home" asp-action="Index" asp-route-page="users">Utilizadores</a>
                            </li>
                        }
                    }
                </ul>

                <ul class="navbar-nav">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (!User.IsInRole("Admin"))
                        {
                            <li class="nav-item me-2">
                                <a class="nav-link text-white position-relative" asp-controller="Bilhete" asp-action="HistoricoCompras" title="Historico de compras">
                                    <i class="bi bi-cart3"></i>
                                </a>
                            </li>
                        }
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle"></i> Olá, <b>@User.Identity.Name</b>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-lg" aria-labelledby="navbarDropdown">
                                <li>
                                    <a class="dropdown-item dropdown-item-details" asp-controller="Utilizador" asp-action="Detalhes">
                                        <i class="bi bi-info-circle"></i> Mais Detalhes
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Login" asp-action="Logout" method="post" class="p-0 m-0">
                                        <button type="submit" class="dropdown-item dropdown-item-logout fw-bold">
                                            <i class="bi bi-box-arrow-right"></i> Sair
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="Index" asp-route-page="login">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="Index" asp-route-page="register">Registo</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
    *@
    }
</header>
}
<div class="@(fullBleed ? "eh-full-bleed" : "container")">
    <main role="main" class="@(fullBleed || hideFooter ? "" : "pb-3")">
        @RenderBody()
    </main>
</div>

@if (!hideChrome && !hideFooter)
{
<footer class="footer">
    <div class="container text-white">
        &copy; 2026 - ES2 - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
    </div>
</footer>
}

@if (User.Identity?.IsAuthenticated == true)
{
    <partial name="_MensagensWidget" />
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/mensagens-widget.js" asp-append-version="true"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
